# Copy this file to .env at the repo root. python-dotenv walks up from the
# current working directory, so a single .env here is picked up regardless of
# which dataset's experiment script you run.
#
# Defaults below match the methodology reported in the paper (Section 3).
# You normally don't need to override anything to reproduce the AVeriTeC runs.

# ===== LLM (shared/config.py) =====
# "hf" (default, Hugging Face transformers) or "ollama" (legacy backend, kept
# for rollback/debugging; Section 6 needs "hf" for hidden-state access)
LLM_BACKEND=hf
# Which of the paper's 6 models to run (folder names + HF_MODEL_MAP key)
OLLAMA_MODEL=llama3.1:8b
# Only used when LLM_BACKEND=hf and OLLAMA_MODEL isn't in shared/config.py's
# HF_MODEL_MAP
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_QUANTIZE_4BIT=true
HF_MAX_NEW_TOKENS=1536
LLM_TEMPERATURE=0.0
LANGUAGE=en

# ===== QUESTION GENERATION (shared/config.py) =====
MAX_QUESTIONS=5
MAX_EVIDENCE=5

# ===== RERANKING (shared/config.py) =====
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RERANKER_THRESHOLD=0.3
USE_RERANKER=true

# ===== PASSAGES (shared/config.py) =====
CHUNK_SIZE=300

# ===== FLAGS (shared/config.py) =====
USE_QUESTION_FOR_RETRIEVAL=true

# ===== AVeriTeC open-web retrieval (corpora/averitec/config.py) =====
SEARCH_ENGINE=duckduckgo
SEARCH_MAX_RESULTS=10
SEARCH_MAX_URLS=30
SEARCH_MAX_WORKERS=10
BM25_TOP_K=10

# Only needed if you switch SEARCH_ENGINE away from duckduckgo:
# BRAVE_API_KEY=
# SERPAPI_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
